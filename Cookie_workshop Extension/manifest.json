{
    "manifest_version": 3,
    "name": "Cookie Workshop",
    "version": "1.0.0",
    "description": "Authorized cookie testing tool for the current tab.",
    "permissions": [
        "cookies",
        "tabs",
        "activeTab"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "popup.html"
    }
}